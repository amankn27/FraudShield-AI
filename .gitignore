# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/
ENV/

# Secrets and local environment files
.env
.env.*
!.env.example

# Raw/processed datasets (retain directory placeholders only)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Trained models and run outputs (usually too large for Git)
models/*
!models/.gitkeep
mlruns/
mlartifacts/

# Notebooks
.ipynb_checkpoints/

# Editor / OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs and temporary files
*.log
tmp/
temp/
