# Copy to .env for local development. Never commit .env or production secrets.
# Default local Postgres service from docker-compose.yml:
DATABASE_URL=postgresql+psycopg://fraudshield:fraudshield_dev_only@localhost:5432/fraudshield
# If DATABASE_URL is configured, persistence is required by default. Set false only for optional logging.
DATABASE_REQUIRED=true

# Existing optional settings can be added here, for example:
# FRAUDSHIELD_DATA_PATH=data/raw/creditcard.csv
